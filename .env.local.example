# Supabase設定
# 以下の値をSupabaseダッシュボード > Settings > APIから取得して設定してください

# Project URL (例: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here

# Anonymous public key (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# 設定手順:
# 1. このファイルを .env.local にコピー
# 2. Supabaseダッシュボードから実際の値を取得
# 3. your_project_url_here と your_anon_key_here を実際の値に置き換え